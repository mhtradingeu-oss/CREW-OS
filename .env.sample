# =========================================================
# MH-OS SUPERAPP — Environment Configuration (FINAL)
# =========================================================

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
NODE_ENV=development
APP_ENV=development

APP_NAME=mh-os-superapp-backend
APP_HOST=127.0.0.1
APP_PORT=4000
APP_BASE_URL=http://127.0.0.1:4000

# ---------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------------------------
DATABASE_PROVIDER=postgresql

DATABASE_URL=postgresql://mhos_user@localhost:5432/mh_os_foundation?schema=public

# Optional (used only in tests if explicitly enabled)
DATABASE_URL_TEST=postgresql://mhos_user@localhost:5432/mh_os_test?schema=public

# Prisma
PRISMA_LOG_LEVEL=info
PRISMA_POOL_SIZE=9

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

INTERNAL_API_KEY=CHANGE_THIS_INTERNAL_KEY

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------
FEATURE_AI_ENABLED=true
FEATURE_AUTOMATION_ENABLED=true
FEATURE_VIRTUAL_OFFICE_ENABLED=true
FEATURE_MEDIA_STUDIO_ENABLED=true

# ---------------------------------------------------------
# AI / LLM (placeholders – safe defaults)
# ---------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4.1
AI_MAX_TOKENS=4096

# ---------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# ---------------------------------------------------------
# Mail (optional – disabled by default)
# ---------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------
# Storage / Media (local for now)
# ---------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ---------------------------------------------------------
# Runtime Guards (DO NOT TOUCH)
# ---------------------------------------------------------
ALLOW_PROD_DB_IN_DEV=false

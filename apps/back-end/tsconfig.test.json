{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["jest", "node"],
    
    "rootDir": "."
    // "allowJs": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.mts",
    "src/tests/**/*.ts",
    "jest.setup.ts",
    "../../packages/shared/src/**/*.ts"
  ],
  "references": [
    { "path": "../../packages/shared" }
  ]
}

# Local backend environment example (copy to `apps/back-end/.env` and adjust before starting)
#
# === Required for all environments ===
NODE_ENV=development         # development | test | production
DATABASE_URL="postgresql://mhos_user:mhos_password@localhost:5432/mhos_dev?schema=public"  # Main DB (dev/prod)
DATABASE_URL_TEST="postgresql://mhos_user:mhos_password@localhost:5432/mhos_test?schema=public"  # Test DB (optional, used if NODE_ENV=test)
ALLOW_REMOTE_DB_IN_DEV=false # Set true ONLY if you want to allow remote/prod DB in dev/test (dangerous!)
METRICS_ENABLED=true         # Enable metrics collection
HEALTH_CORRELATION_ID=cid-123 # Example correlation ID for health checks

# === Other common settings ===
PORT=4000
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-this-secret-locally"
ADMIN_EMAIL=dev.superadmin@example.com
ADMIN_PASSWORD=Dev12345!
OPENAI_API_KEY=your-openai-key-here
AI_INTEGRATIONS_OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=openai
HEALTH_INCLUDE_CORRELATION_ID=true
READINESS_ENABLED=true
READINESS_STRICT=false
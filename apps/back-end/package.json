{
  "name": "mh-os-superapp-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node --enable-source-maps src/server.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "db:migrate": "node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/migration-guard.ts && prisma migrate deploy",
    "seed:admin": "node --loader ts-node/esm --experimental-specifier-resolution=node ./src/seeds/admin.seed.ts",
    "db:seed": "prisma db seed",
    "auto:new-module": "ts-node scripts/auto-dev/new-module.ts",
    "postinstall": "prisma generate",
    "seed:rbac:dist": "node dist/modules/security-governance/rbac.seed.js",
    "seed:brand:hairoticmen:dist": "node dist/modules/brand/hairoticmen.seed.js",
    "seed:rbac:local": "node --loader ts-node/esm --experimental-specifier-resolution=node ./src/modules/security-governance/rbac.seed.ts",
    "seed:brand:hairoticmen": "node --loader ts-node/esm --experimental-specifier-resolution=node ./src/modules/brand/hairoticmen.seed.ts",
    "seed:core": "node --loader ts-node/esm --experimental-specifier-resolution=node ./src/seeds/core.seed.ts",
    "seed:tenants": "node --loader ts-node/esm --experimental-specifier-resolution=node ./src/seeds/tenants.seed.ts",
    "seed:all": "npm run seed:core && npm run seed:tenants",
    "smoke:phase5": "node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/phase5-automation-smoke.ts",
    "test:prepare": "NODE_ENV=test MHOS_BACKEND_ENV_PATH=.env.test npm run db:migrate",
    "test:unit": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test": "npm run test:unit",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testMatch '**/tests/integration/**/*.int.test.ts'",
    "test:contract": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testMatch '**/tests/contract/**/*.contract.test.ts' --passWithNoTests",
    "event:audit": "ts-node scripts/event-audit-report.ts",
    "check:event-contracts": "ts-node scripts/check-event-contracts.ts",
    "check:automation-actions": "ts-node scripts/check-automation-actions.ts"
  },
  "dependencies": {
    "@mh-os/shared": "file:../../packages/shared",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.66.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.8.2",
    "json-logic-js": "^2.0.5",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/json-logic-js": "^2.0.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.17",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm --experimental-specifier-resolution=node ./prisma/seed.ts"
  }
}

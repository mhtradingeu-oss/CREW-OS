generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Intelligence Analytics Table: FeatureUsageDaily (read-only, analytics aggregation)
model FeatureUsageDaily {
  /// Primary key
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  featureCode String   @map("featureCode")
  planKey     String   @map("planKey")
  tenantId    String?  @map("tenantId")
  brandId     String?  @map("brandId")
  partnerId   String?  @map("partnerId")
  routePath   String   @map("routePath")
  usageDate   DateTime @map("usageDate") @db.Date
  usageCount  Int      @default(1) @map("usageCount")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @map("updatedAt")

  @@unique([featureCode, planKey, tenantId, brandId, partnerId, routePath, usageDate], map: "FeatureUsageDaily_unique")
  @@map("FeatureUsageDaily")
}

/// Intelligence Analytics Table: PlanIntelligenceInsight (read-only, async, safe)
model PlanIntelligenceInsight {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  planKey     String   @map("planKey")
  featureCode String   @map("featureCode")
  tenantId    String?  @map("tenantId")
  brandId     String?  @map("brandId")
  partnerId   String?  @map("partnerId")
  insightType String   @map("insightType")
  insightJson Json     @map("insightJson")
  detectedAt  DateTime @default(now()) @map("detectedAt")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @map("updatedAt")

  @@map("PlanIntelligenceInsight")
}

/// Intelligence Analytics Table: AICrewRecommendation (read-only, async, safe)
model AICrewRecommendation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  crew               String   @map("crew")
  recommendationType String   @map("recommendationType")
  rationale          String?  @map("rationale")
  confidence         Float?   @map("confidence")
  riskLevel          String?  @map("riskLevel")
  insightId          String?  @map("insightId")
  createdAt          DateTime @default(now()) @map("createdAt")
  updatedAt          DateTime @default(now()) @map("updatedAt")

  @@map("AICrewRecommendation")
}

model ActionSuggestion {
  id               String    @id @default(cuid())
  insightId        String?
  recommendationId String?
  tenantId         String?
  brandId          String?
  partnerId        String?
  featureCode      String?
  insightType      String?
  crew             String?
  suggestedAction  String
  rationale        String?
  confidence       Float?
  riskLevel        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  acknowledgedAt   DateTime?
  decisionReason   String?
  dismissedAt      DateTime?

  @@index([tenantId])
  @@index([brandId])
  @@index([partnerId])
  @@index([featureCode])
  @@index([insightType])
  @@index([crew])
  @@index([createdAt])
}

model AIAgentBudget {
  id               String   @id @default(cuid())
  agentName        String
  brandId          String?
  tenantId         String?
  dailyBudgetUsd   Float?
  monthlyBudgetUsd Float?
  tokenLimit       Int?
  alertThreshold   Float?   @default(0.8)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  brand            Brand?   @relation(fields: [brandId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([agentName, brandId, tenantId])
  @@index([createdAt])
}

model AIExecutionLog {
  id               String            @id @default(cuid())
  runId            String
  agentName        String?
  namespace        String?
  model            String?
  provider         String?
  status           AIExecutionStatus
  riskLevel        AIRiskLevel?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  promptPreview    String?
  outputPreview    String?
  errorMessage     String?
  brandId          String?
  tenantId         String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  brand            Brand?            @relation(fields: [brandId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])

  @@index([brandId])
  @@index([tenantId])
  @@index([namespace])
  @@index([agentName])
  @@index([createdAt])
}

model AIInsight {
  id         String   @id @default(cuid())
  brandId    String?
  os         String?
  entityType String?
  entityId   String?
  summary    String?
  details    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brand      Brand?   @relation(fields: [brandId], references: [id])
}

model AILearningJournal {
  id                 String        @id @default(cuid())
  productId          String?
  brandId            String?
  source             String?
  eventType          String?
  inputSnapshotJson  String?
  outputSnapshotJson String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  brand              Brand?        @relation(fields: [brandId], references: [id])
  product            BrandProduct? @relation(fields: [productId], references: [id])

  @@index([brandId])
  @@index([productId])
}

model AIMonitoringEvent {
  id        String               @id @default(cuid())
  category  AIMonitoringCategory
  status    String?
  metric    Json?
  agentName String?
  engine    String?
  namespace String?
  riskLevel AIRiskLevel?
  brandId   String?
  tenantId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  brand     Brand?               @relation(fields: [brandId], references: [id])
  tenant    Tenant?              @relation(fields: [tenantId], references: [id])

  @@index([category])
  @@index([brandId])
  @@index([tenantId])
  @@index([createdAt])
}

model AIPricingHistory {
  id              String       @id @default(cuid())
  productId       String
  brandId         String?
  channel         String?
  oldNet          Decimal?
  newNet          Decimal?
  aiAgent         String?
  confidenceScore Decimal?
  summary         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  brand           Brand?       @relation(fields: [brandId], references: [id])
  product         BrandProduct @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([brandId])
}

model AIPromptFirewallRule {
  id           String         @id @default(cuid())
  name         String
  matcherType  String
  matcherValue String
  action       AIPromptAction
  reason       String?
  severity     AIRiskLevel?
  active       Boolean        @default(true)
  tags         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AIReport {
  id          String    @id @default(cuid())
  brandId     String?
  title       String
  scope       String?
  periodStart DateTime?
  periodEnd   DateTime?
  content     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  brand       Brand?    @relation(fields: [brandId], references: [id])
}

model AIRestrictionPolicy {
  id        String   @id @default(cuid())
  name      String
  rulesJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AISafetyConstraint {
  id                    String   @id @default(cuid())
  code                  String   @unique
  scope                 String?
  description           String?
  ruleJson              String?
  allowedActionsJson    String?
  restrictedDomainsJson String?
  riskScore             Int?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AISafetyEvent {
  id        String            @id @default(cuid())
  type      AISafetyEventType
  action    String?
  ruleId    String?
  runId     String?
  agentName String?
  namespace String?
  riskLevel AIRiskLevel?
  decision  String?
  detail    Json?
  brandId   String?
  tenantId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  brand     Brand?            @relation(fields: [brandId], references: [id])
  tenant    Tenant?           @relation(fields: [tenantId], references: [id])

  @@index([type])
  @@index([brandId])
  @@index([tenantId])
  @@index([createdAt])
}

model AISuggestion {
  id                   String                       @id @default(cuid())
  tenantId             String
  brandId              String
  agent                String
  domain               String
  suggestionType       String
  riskLevel            String
  status               AISuggestionStatus           @default(pending)
  requiredApprovalRole String
  inputSnapshotJson    String
  proposedOutputJson   String
  approvedByUserId     String?
  approvedAt           DateTime?
  executedAt           DateTime?
  failureReason        String?
  correlationId        String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  approvalDecisions    AutomationApprovalDecision[]

  @@index([tenantId])
  @@index([brandId])
  @@index([status])
  @@index([correlationId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  brandId   String?
  userId    String?
  module    String?
  type      String
  source    String?
  severity  String?
  metaJson  String?
  createdAt DateTime @default(now())
  brand     Brand?   @relation(fields: [brandId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([brandId])
  @@index([userId])
  @@index([createdAt])
}

model Affiliate {
  id               String                 @id @default(cuid())
  brandId          String?
  userId           String?
  personId         String?
  tierId           String?
  code             String?                @unique
  type             String?
  channel          String?
  status           String?                @default("ACTIVE")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  person           Person?                @relation(fields: [personId], references: [id])
  user             User?                  @relation(fields: [userId], references: [id])
  conversions      AffiliateConversion[]  @relation("AffiliateConversionToAffiliate")
  links            AffiliateLink[]
  payouts          AffiliatePayout[]
  performance      AffiliatePerformance[]
  sales            AffiliateSale[]
  ownedWhiteLabels WhiteLabelBrand[]      @relation("WL_AffiliateOwner")
}

model AffiliateConversion {
  id          String    @id @default(cuid())
  brandId     String?
  affiliateId String
  orderId     String?
  amount      Decimal?
  currency    String?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation("AffiliateConversionToAffiliate", fields: [affiliateId], references: [id])
  brand       Brand?    @relation("AffiliateConversionToBrand", fields: [brandId], references: [id])
}

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  linkCode    String    @unique
  targetUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
}

model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  amount      Decimal?
  currency    String?
  status      String?
  paidAt      DateTime?
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  method      String?
  notes       String?
  brandId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  brand       Brand?    @relation("AffiliatePayoutToBrand", fields: [brandId], references: [id])
}

model AffiliatePerformance {
  id          String    @id @default(cuid())
  affiliateId String
  period      String?
  clicks      Int       @default(0)
  orders      Int       @default(0)
  revenue     Decimal?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
}

model AffiliateSale {
  id          String        @id @default(cuid())
  affiliateId String
  productId   String?
  orderValue  Decimal?
  commission  Decimal?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  affiliate   Affiliate     @relation(fields: [affiliateId], references: [id])
  product     BrandProduct? @relation(fields: [productId], references: [id])
}

model AudienceSegment {
  id        String   @id @default(cuid())
  brandId   String?
  name      String
  filters   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand?   @relation(fields: [brandId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])
}

model AutomationActionRun {
  id               String                    @id @default(cuid())
  runId            String
  actionIndex      Int
  actionType       String
  status           AutomationActionRunStatus @default(PENDING)
  attemptCount     Int                       @default(0)
  nextAttemptAt    DateTime?
  dedupKey         String                    @unique
  actionConfigJson Json
  resultJson       Json?
  errorJson        Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  summary          String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  run              AutomationRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model AutomationApprovalDecision {
  id           String                      @id @default(cuid())
  suggestionId String?
  status       AutomationApprovalStatus    @default(PENDING)
  snapshotHash String
  environment  String
  approvedById String?
  approvedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  suggestion   AISuggestion?               @relation(fields: [suggestionId], references: [id])
  executions   AutomationExecutionLedger[]
  incidents    AutomationIncident[]

  @@index([status])
}

model AutomationBrandKillSwitch {
  brandId       String    @id
  tenantId      String?
  enabled       Boolean   @default(false)
  reason        String?
  activatedById String?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
}

model AutomationExecutionKillSwitch {
  id            String                              @id @default(cuid())
  targetId      String
  targetType    AutomationExecutionKillSwitchTarget
  reason        String
  isActive      Boolean                             @default(true)
  activatedById String?
  activatedAt   DateTime                            @default(now())
  incidentId    String?
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt
  incident      AutomationIncident?                 @relation(fields: [incidentId], references: [incidentId])

  @@index([targetId, targetType])
  @@index([incidentId])
}

model AutomationExecutionLedger {
  id                 String                              @id @default(cuid())
  approvalDecisionId String
  suggestionId       String?
  snapshotHash       String
  environment        String
  executedById       String
  executedAt         DateTime                            @default(now())
  result             AutomationExecutionResult
  errorCode          String?
  errorMessage       String?
  actionType         String
  actionPayloadJson  Json?
  metadataJson       Json?
  approvalDecision   AutomationApprovalDecision          @relation(fields: [approvalDecisionId], references: [id], onDelete: Cascade)
  executedBy         User                                @relation(fields: [executedById], references: [id], onDelete: Cascade)
  incidents          AutomationIncident[]
  rollbackExecutions AutomationRollbackExecutionLedger[]

  @@index([approvalDecisionId])
  @@index([executedById])
}

model AutomationExecutionLog {
  id           String         @id @default(cuid())
  ruleId       String
  eventName    String?
  status       String
  resultJson   String?
  errorMessage String?
  runAt        DateTime       @default(now())
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model AutomationIncident {
  incidentId                String                              @id @default(cuid())
  type                      AutomationIncidentType
  severity                  AutomationIncidentSeverity
  status                    AutomationIncidentStatus            @default(OPEN)
  description               String?
  detectedAt                DateTime                            @default(now())
  detectedBy                AutomationDetectionSource
  detectedById              String?
  metadataJson              Json?
  relatedExecutionId        String?
  relatedApprovalDecisionId String?
  mitigationNotesJson       Json?
  resolutionNotesJson       Json?
  mitigatedAt               DateTime?
  resolvedAt                DateTime?
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  executionKillSwitches     AutomationExecutionKillSwitch[]
  relatedApprovalDecision   AutomationApprovalDecision?         @relation(fields: [relatedApprovalDecisionId], references: [id])
  relatedExecution          AutomationExecutionLedger?          @relation(fields: [relatedExecutionId], references: [id])
  rollbackExecutions        AutomationRollbackExecutionLedger[]

  @@index([relatedExecutionId])
  @@index([relatedApprovalDecisionId])
}

model AutomationLog {
  id          String   @id @default(cuid())
  brandId     String?
  eventName   String?
  ruleId      String?
  workflowId  String?
  result      String?
  detailsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand?   @relation(fields: [brandId], references: [id])
}

model AutomationRollbackExecutionLedger {
  id                String                    @id @default(cuid())
  executionId       String
  incidentId        String
  approvedById      String
  approvedAt        DateTime
  reason            String
  snapshotReference String
  scopeDescription  String
  status            AutomationRollbackStatus  @default(PENDING)
  requestedById     String?
  executedAt        DateTime?
  metadataJson      Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  execution         AutomationExecutionLedger @relation(fields: [executionId], references: [id], onDelete: Cascade)
  incident          AutomationIncident        @relation(fields: [incidentId], references: [incidentId])

  @@index([executionId])
  @@index([incidentId])
}

model AutomationRule {
  id             String                       @id @default(cuid())
  brandId        String?
  name           String
  description    String?
  state          AutomationRuleLifecycleState @default(DRAFT)
  enabled        Boolean                      @default(true)
  triggerEvent   String?
  triggerType    String?
  actionsJson    Json?
  conditionsJson Json?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  createdById    String?
  updatedById    String?
  lastRunAt      DateTime?
  lastRunStatus  String?
  executionLogs  AutomationExecutionLog[]
  brand          Brand?                       @relation(fields: [brandId], references: [id])
  versions       AutomationRuleVersion[]
  automationRuns AutomationRun[]
}

model AutomationRuleVersion {
  id                  String                       @id @default(cuid())
  ruleId              String
  versionNumber       Int
  triggerEvent        String
  conditionConfigJson Json
  actionsConfigJson   Json
  metaSnapshotJson    Json?
  createdAt           DateTime                     @default(now())
  createdById         String?
  state               AutomationRuleLifecycleState @default(DRAFT)
  rule                AutomationRule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  runs                AutomationRun[]

  @@unique([ruleId, versionNumber])
}

model AutomationRun {
  id               String                @id @default(cuid())
  ruleId           String
  ruleVersionId    String
  eventName        String
  eventId          String?
  status           AutomationRunStatus   @default(PENDING)
  startedAt        DateTime?
  finishedAt       DateTime?
  summaryJson      Json?
  errorJson        Json?
  triggerEventJson Json?
  conditionsJson   Json?
  actionsJson      Json?
  ruleMetaJson     Json?
  dedupKey         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  actionRuns       AutomationActionRun[]
  rule             AutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleVersion      AutomationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([ruleVersionId])
  @@index([eventId])
}

model Brand {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  description              String?
  countryOfOrigin          String?
  defaultCurrency          String?
  settingsJson             String?
  tenantId                 String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  aiAgentBudgets           AIAgentBudget[]
  aiAgentConfigs           AIAgentConfig[]
  aiExecutionLogs          AIExecutionLog[]
  aiInsights               AIInsight[]
  aiLearningJournals       AILearningJournal[]
  aiMonitoringEvents       AIMonitoringEvent[]
  aiPricingHistories       AIPricingHistory[]
  aiReports                AIReport[]
  aiSafetyEvents           AISafetyEvent[]
  activityLogs             ActivityLog[]
  affiliates               Affiliate[]
  affiliateConversions     AffiliateConversion[]      @relation("AffiliateConversionToBrand")
  affiliatePayouts         AffiliatePayout[]          @relation("AffiliatePayoutToBrand")
  audienceSegments         AudienceSegment[]
  automationKillSwitch     AutomationBrandKillSwitch?
  automationLogs           AutomationLog[]
  automationRules          AutomationRule[]
  tenant                   Tenant?                    @relation("TenantBrands", fields: [tenantId], references: [id])
  aiConfig                 BrandAIConfig?
  categories               BrandCategory[]
  identity                 BrandIdentity?
  products                 BrandProduct[]
  rules                    BrandRules?
  crmSegments              CRMSegment[]
  crmTasks                 CRMTask[]
  campaigns                Campaign[]
  companies                Company[]
  competitorPrices         CompetitorPrice[]
  competitorSocialReports  CompetitorSocialReport[]
  deals                    Deal[]
  dealerKpis               DealerKpi[]
  FinanceExpense           FinanceExpense[]
  FinanceInvoice           FinanceInvoice[]
  financialKpiRecords      FinancialKPIRecord[]
  influencerCampaignLinks  InfluencerCampaignLink[]   @relation("BrandToInfluencerCampaignLink")
  influencerDiscoveryTasks InfluencerDiscoveryTask[]  @relation("BrandToInfluencerDiscoveryTask")
  influencerNegotiations   InfluencerNegotiation[]    @relation("BrandToInfluencerNegotiation")
  influencerProfiles       InfluencerProfile[]
  influencerStatSnapshots  InfluencerStatSnapshot[]   @relation("BrandToInfluencerStatSnapshot")
  inventoryItems           InventoryItem[]
  invoices                 Invoice[]
  knowledgeCategories      KnowledgeCategory[]
  knowledgeDocuments       KnowledgeDocument[]
  leads                    Lead[]
  loyaltyCustomers         LoyaltyCustomer[]
  loyaltyPrograms          LoyaltyProgram[]
  loyaltyRewards           LoyaltyReward[]
  loyaltyTiers             LoyaltyTier[]              @relation("LoyaltyTierToBrand")
  loyaltyTransactions      LoyaltyTransaction[]
  notifications            Notification[]
  notificationTemplates    NotificationTemplate[]
  operationsTasks          OperationsTask[]
  partners                 Partner[]
  partnerOrders            PartnerOrder[]
  partnerTiers             PartnerTier[]
  persons                  Person[]
  policies                 Policy[]
  productPriceDrafts       ProductPriceDraft[]
  productPricings          ProductPricing[]
  revenueRecords           RevenueRecord[]
  SalesLead                SalesLead[]
  salesOrders              SalesOrder[]
  salesReps                SalesRep[]
  SalesRepKpiSnapshot      SalesRepKpiSnapshot[]
  salesVisits              SalesVisit[]
  scheduledJobs            ScheduledJob[]
  socialMentions           SocialMention[]
  socialTrends             SocialTrend[]
  Stand                    Stand[]
  standKpis                StandKpi[]
  standOrders              StandOrder[]
  standPartners            StandPartner[]
  StandPerformanceSnapshot StandPerformanceSnapshot[]
  StandRefillOrder         StandRefillOrder[]
  defaultForTenants        Tenant[]                   @relation("TenantDefaultBrand")
  tickets                  Ticket[]
  ticketAssignments        TicketAssignment[]
  users                    User[]                     @relation("BrandUsers")
  virtualOfficeActionItems VirtualOfficeActionItem[]
  virtualOfficeMeetings    VirtualOfficeMeeting[]
  voiceSessions            VoiceSession[]
  warehouses               Warehouse[]
  whiteLabelBrands         WhiteLabelBrand[]
}

model BrandAIConfig {
  id                   String   @id @default(cuid())
  brandId              String   @unique
  aiPersonality        String?
  aiTone               String?
  aiContentStyle       String?
  aiPricingStyle       String?
  aiEnabledActionsJson String?
  aiBlockedTopicsJson  String?
  aiModelVersion       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  brand                Brand    @relation(fields: [brandId], references: [id])
}

model BrandCategory {
  id          String         @id @default(cuid())
  brandId     String?
  name        String
  slug        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  brand       Brand?         @relation(fields: [brandId], references: [id])
  products    BrandProduct[]
}

model BrandIdentity {
